{
  "$schema": "./node_modules/@iwsdk/core/dist/schemas/iwsdk-project.v1.schema.json",
  "version": "iwsdk.project.v1",
  "scene": "./public/scenes/deskborn-day2.iwsdk.scene.json",
  "world": {
    "xr": {
      "mode": "ar",
      "offer": "always",
      "features": {
        "handTracking": true,
        "anchors": false,
        "hitTest": {
          "required": true
        },
        "planeDetection": false,
        "meshDetection": false,
        "layers": true
      }
    },
    "render": {
      "camera": {
        "position": [
          0,
          1,
          0.5
        ]
      }
    },
    "features": {
      "locomotion": false,
      "grabbing": true,
      "physics": false,
      "sceneUnderstanding": false,
      "environmentRaycast": true
    }
  },
  "dev": {
    "emulator": {
      "device": "metaQuest3",
      "environment": "sunlit_living_room",
      "activation": "always",
      "injectOnBuild": false
    }
  }
}
